---
---
<div class="publication-item">
  <div class="preview">
    {% if entry.thumbnail %}
      <img src="{{ entry.thumbnail | relative_url }}" alt="thumbnail">
    {% elsif entry.preview %}
      {% if entry.preview contains '://' %}
        <img src="{{ entry.preview }}" alt="thumbnail">
      {% else %}
        <img src="{{ '/assets/img/' | append: entry.preview | relative_url }}" alt="thumbnail">
      {% endif %}
    {% endif %}
  </div>

  <div class="pub-info">
    <!-- Title -->
    <div class="title">{{ entry.title }}</div>

    <!-- Authors + Journal + Year (inline) -->
    <div class="author" style="font-size: 0.92em;">
      {% for author in entry.author_array %}
        {% assign fname = author.first | strip %}
        {% assign lname = author.last | strip %}
        {% assign full_name = fname | append: ' ' | append: lname %}
        {% if fname == "A." and lname == "Farzmahdi" %}
          <span style="text-decoration: underline; text-decoration-thickness: 2px;">{{ full_name }}</span>
        {% else %}
          {{ full_name }}
        {% endif %}
        {% unless forloop.last %}, {% endunless %}
      {% endfor %}
      
      {% if entry.journal and entry.year %}
  <span style="font-size: 1em; color: #555;">
    — <span style="font-style: italic; text-decoration: none;">{{ entry.journal }}</span> ({{ entry.year }})
  </span>
{% endif %}

    </div>

    <!-- Links -->
    <div class="links">
      {% if entry.abstract %}
        <a class="abstract btn btn-sm" role="button">Abs</a>
      {% endif %}
      {% if entry.doi %}
        <a href="https://doi.org/{{ entry.doi }}" class="btn btn-sm" role="button">DOI</a>
      {% endif %}
      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          <a href="{{ entry.pdf }}" class="btn btn-sm" role="button">PDF</a>
        {% else %}
          <a href="{{ '/assets/pdf/' | append: entry.pdf | relative_url }}" class="btn btn-sm" role="button">PDF</a>
        {% endif %}
      {% endif %}
    </div>

    <!-- Abstract -->
    {% if entry.abstract %}
      <div class="abstract hidden">
        <p>{{ entry.abstract }}</p>
      </div>
    {% endif %}
  </div>
</div>
